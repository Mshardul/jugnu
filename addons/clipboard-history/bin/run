#!/bin/bash
set -euo pipefail

STATE_DIR="$HOME/.local/share/jugnu/state/clipboard-history"
DB="$STATE_DIR/history.db"
ADDON_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
PLIST_LABEL="com.jugnu.clipboard-history.watch"
PLIST_PATH="$LAUNCH_AGENTS/${PLIST_LABEL}.plist"

mkdir -p "$STATE_DIR"

sqlite3 "$DB" <<'SQL'
CREATE TABLE IF NOT EXISTS entries (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  ts REAL NOT NULL,
  text TEXT NOT NULL,
  pinned INTEGER NOT NULL DEFAULT 0
);
CREATE INDEX IF NOT EXISTS idx_entries_ts ON entries(ts DESC);
SQL

# Lazily install + load the background watcher agent on first use (the shell
# only tears down launchd labels on disable/uninstall; it does not bootstrap
# them, so the addon self-installs idempotently here).
ensure_watcher() {
  mkdir -p "$LAUNCH_AGENTS"
  if [[ ! -f "$PLIST_PATH" ]]; then
    cat > "$PLIST_PATH" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${ADDON_DIR}/bin/watch</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>${STATE_DIR}/watch.log</string>
  <key>StandardOutPath</key><string>${STATE_DIR}/watch.log</string>
</dict>
</plist>
EOF
  fi
  launchctl bootstrap "gui/$(id -u)" "$PLIST_PATH" >/dev/null 2>&1 || true
}

ensure_watcher

req=$(cat)

json_get_str() {
  printf '%s' "$1" | sed -n -E "s/.*\"$2\":\"((\\\\.|[^\"\\\\])*)\".*/\1/p" | head -n1
}

# The shell's list panel filters items client-side (P1) and, on selection,
# re-invokes this same command with itemId + action (default "select") — it
# never sends a separate "search" command or a free-text query arg.
item_id=$(json_get_str "$req" "itemId")

emit_list() {
  local items
  # sqlite3 -json emits a JSON array directly; select columns pre-shaped as
  # {id,title,subtitle} so no separate JSON transform step is needed. ids are
  # cast to strings to match the UI list item model.
  items=$(sqlite3 -json "$DB" "
    SELECT CAST(id AS TEXT) AS id,
           substr(replace(text, char(10), ' '), 1, 80) AS title,
           CASE WHEN pinned = 1 THEN 'pinned' ELSE '' END AS subtitle
    FROM entries
    ORDER BY ts DESC, id DESC LIMIT 50;
  ")
  if [[ -z "$items" ]]; then
    items="[]"
  fi
  echo "{\"ok\":true,\"ui\":{\"pattern\":\"list\",\"title\":\"Clipboard History\",\"items\":${items}}}"
}

if [[ -n "$item_id" ]]; then
  if [[ ! "$item_id" =~ ^[0-9]+$ ]]; then
    echo '{"ok":false,"error":"invalid itemId"}'
    exit 0
  fi
  text=$(sqlite3 "$DB" "SELECT text FROM entries WHERE id = ${item_id};")
  printf '%s' "$text" | pbcopy
  echo '{"ok":true,"message":"copied"}'
  exit 0
fi

emit_list
